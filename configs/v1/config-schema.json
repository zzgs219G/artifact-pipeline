{
  "schema_version": 1,
  "modules_expected": [
    "sigcheck",
    "dex2c",
    "soguard",
    "stringenc",
    "antidiff",
    "envcheck",
    "packer"
  ],
  "label": "加固模块",
  "desc": "给 APK 加防御：签名校验 / 核心逻辑转 C / 字符串加密 / 防对比 / 环境检测 / 加壳",
  "modules": [
    {
      "key": "sigcheck",
      "label": "签名校验",
      "desc": "签名不匹配直接拒绝启动。",
      "type": "leaf",
      "default": true,
      "arg": "--sigcheck"
    },
    {
      "key": "dex2c",
      "label": "Dex2C",
      "desc": "Java 方法转成 C 编译进 so，比解释执行更快。",
      "type": "parent",
      "default": false,
      "arg": "--dex2c",
      "group_label": "转译范围",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "hint": "留空：自动抽取主界面类（从 APK 的 Manifest 解析，不依赖签名校验）；也可填写 com.test.** 等定向规则。不支持 ** 全量（整个 App 转译，引擎不支持）"
        }
      ]
    },
    {
      "key": "soguard",
      "label": "so层保护",
      "desc": "VMP 虚拟化 + 附加混淆。VMP 挡动态 dump，混淆补调用关系。",
      "type": "parent",
      "default": true,
      "arg": "--vmp",
      "group_label": "防护层（VMP 默认开，可关）",
      "children": [
        {
          "key": "vm",
          "label": "VMP 虚拟化",
          "desc": "关键函数编译成 VM 字节码，挡动态 dump。约 +470KB。",
          "type": "checkbox",
          "default": true,
          "value_kind": "flag",
          "arg_on": "--vmp-vm"
        },
        {
          "key": "mba",
          "label": "算术混淆（MBA）",
          "desc": "算术运算换成等价但难读的形式。强度低。",
          "type": "checkbox",
          "default": true,
          "value_kind": "flag",
          "arg_on": "--obfuscate-mba"
        },
        {
          "key": "param_aggregate",
          "label": "参数聚合",
          "desc": "参数打包成结构体。不影响控制流，可与 VMP 共用。",
          "type": "checkbox",
          "default": true,
          "value_kind": "flag",
          "arg_on": "--obfuscate-param-aggregate"
        },
        {
          "key": "vm_flatten",
          "label": "动态控制流（抗动态分析）",
          "desc": "每次运行控制流不同，抗反复试跑。编译开销较大。",
          "type": "checkbox",
          "default": true,
          "value_kind": "flag",
          "arg_on": "--obfuscate-vm-flatten"
        }
      ]
    },
    {
      "key": "stringenc",
      "label": "字符串加密",
      "desc": "字符串常量加密，运行时自动解密。",
      "type": "parent",
      "default": false,
      "arg": "--stringenc",
      "group_label": "加密范围",
      "children": [
        {
          "key": "algo",
          "label": "密钥流算法",
          "type": "radio",
          "value_kind": "choice",
          "default": "splitmix64",
          "options": [
            {
              "value": "splitmix64",
              "label": "速度优先",
              "desc": "splitmix64 密钥流：解密最快。但它是可逆的 —— 攻击者拿到任意一条明文就能反推出密钥，进而解开全部字符串。",
              "arg_on": ""
            },
            {
              "value": "chacha20",
              "label": "安全优先",
              "desc": "ChaCha20 密钥流：猜中一条明文只泄漏那一条，解不出密钥。代价是首次解密多算一些（走缓存后无差异）。",
              "arg_on": "--stringenc-chacha20"
            }
          ]
        },
        {
          "key": "dex2c_stub",
          "hidden": true,
          "label": "解密桩也抽进 so",
          "desc": "把注入的 Java 解密桩也交给 dex2c 转译。当前无作用对象。",
          "type": "checkbox",
          "default": false,
          "value_kind": "flag",
          "arg_on": "--dex2c-stub"
        },
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": {
            "when": "always"
          },
          "hint": "每行一条，支持 ** / com.test.** / activity*"
        }
      ]
    },
    {
      "key": "antidiff",
      "label": "防对比混淆",
      "desc": "改写 dex 结构，原版与加固版无法直接对比。",
      "type": "leaf",
      "default": false,
      "arg": "--anti-diff"
    },
    {
      "key": "envcheck",
      "label": "环境检测",
      "desc": "检测 Frida / Xposed / 调试器，发现即处置。",
      "type": "leaf",
      "default": false,
      "arg": "--envcheck"
    },
    {
      "key": "packer",
      "label": "基础加壳",
      "desc": "整个 dex 加密。启动会变慢（无法预编译）。",
      "type": "parent",
      "default": false,
      "arg": "--packer",
      "group_label": "加壳选项",
      "children": [
        {
          "key": "smaller",
          "label": "体积优化",
          "desc": "压缩产物体积。",
          "type": "checkbox",
          "default": true,
          "value_kind": "flag",
          "arg_on": "--packer-smaller"
        },
        {
          "key": "exclude_x86",
          "label": "排除模拟器架构",
          "desc": "不带 x86 / x86_64（真机几乎不用）。",
          "type": "checkbox",
          "default": true,
          "value_kind": "arg_value",
          "arg_on": "--exclude-abi",
          "arg_value": "x86,x86_64"
        }
      ]
    }
  ]
}
