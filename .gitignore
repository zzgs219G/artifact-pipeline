build/
# dex2c.zip 解压产物(tools/Dex2C/ 单层,真源是 tools/dex2c.zip)
/tools/Dex2C/
# dpt-shell.zip 解压产物(tools/executable/ 单层,真源是 tools/dpt-shell.zip)
/tools/executable/
# nox.zip 解压产物(tools/nox/ 单层,真源是 tools/nox.zip;上游 nox 仓库)
/tools/nox/
# 历史残留：nox-src.zip 已于 b655f0a 删除（回归测试改读 ../nox 仓库源码）。
# 这条忽略规则仅用于清掉旧克隆里残留的解压目录，勿再写入新文件。
/tools/nox-src/
.gradle/
.idea/
local.properties
*.log
.DS_Store
__pycache__/
*.pyc
node_modules/
dist/
.env
*.class
*.apk
# 测试样本：AI/新接手者要能直接找到，故入库（2026-11-02）
!scripts/样本.apk
*.ipa
# stringenc 测试的临时工作目录（test-link-dex2c.sh 首行 rm -rf work 重建）。
# 2026-11-01 前它的产物被误提交入库，导致每次跑测试都产生随机桩名的脏 diff。
/scripts/string-enc/tests/work/
/.nox-tmp/

# resolve-config.py 的运行期输出（一行一个参数，每次运行 makedirs 重建）。
# 它是 configs/ → protect.sh 的参数传递通道，不是配置源；改配置请改 configs/。
# 提交它会造成每次构建都产生无意义 diff（同 /scripts/string-enc/tests/work/ 一类）。
/schema_rules/
